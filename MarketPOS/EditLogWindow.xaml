<Window x:Class="MarketPOS.EditLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kayıt Düzenle" Height="500" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    
    <Border Background="#F8FAFC" CornerRadius="20" Padding="25">
        <Border.Effect>
            <DropShadowEffect RenderingBias="Performance" Color="#64748B" Opacity="0.2" BlurRadius="25" ShadowDepth="10"/>
        </Border.Effect>

        <StackPanel>
            <TextBlock Text="📝 Kayıt Düzenle" FontSize="20" FontWeight="ExtraBold" Margin="0,0,0,25" Foreground="#1E293B" HorizontalAlignment="Center"/>

            <TextBlock Text="Tarih" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,5"/>
            <TextBox Text="{Binding Date, StringFormat='yyyy-MM-dd HH:mm:ss'}" Height="45" VerticalContentAlignment="Center" FontSize="14" FontWeight="SemiBold" Padding="10" 
                     BorderBrush="#CBD5E1" BorderThickness="2" Margin="0,0,0,20">
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="10"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>

            <TextBlock Text="Islem Tipi" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,5"/>
            <TextBox Text="{Binding DisplayActionType}" Height="45" VerticalContentAlignment="Center" FontSize="14" FontWeight="Bold" Padding="10" 
                     BorderBrush="#CBD5E1" BorderThickness="2" Margin="0,0,0,20">
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="10"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>

            <TextBlock Text="Detay / Açıklama" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,5"/>
            <TextBox Text="{Binding Description}" Height="100" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="14" Padding="10" 
                     BorderBrush="#CBD5E1" BorderThickness="2" Margin="0,0,0,30">
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="10"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                
                <Button Content="IPTAL" IsCancel="True" Click="BtnCancel_Click" Height="50" Background="#F1F5F9" Foreground="#64748B" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="12"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Grid.Column="2" Content="GÜNCELLE" Click="BtnSave_Click" Height="50" Background="#3B82F6" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="12"/>
                        </Style>
                    </Button.Resources>
                    <Button.Effect>
                        <DropShadowEffect RenderingBias="Performance" Color="#3B82F6" Opacity="0.3" BlurRadius="10" ShadowDepth="3"/>
                    </Button.Effect>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</Window>
