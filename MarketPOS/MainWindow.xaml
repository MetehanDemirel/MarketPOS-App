                                Foreground="#94A3B8" />
                            <DatePicker SelectedDate="{Binding LogEndDate}" Width="140" Height="40"
                                VerticalContentAlignment="Center" />

                            <CheckBox IsChecked="{Binding HideFinancialLogs}"
                                Content="Sadece Sistem Kayıtları (Finansalı Gizle)"
                                VerticalAlignment="Center" Margin="25,0,0,0" FontSize="14" />

                            <Button Content="LİSTEYİ YENİLE" Command="{Binding RefreshLogsCommand}"
                                Margin="25,0,0,0" Width="140" Height="40" Background="#F1F5F9"
                                Foreground="#475569" FontWeight="Bold"
                                Style="{StaticResource RoundedBtn}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Background="White" CornerRadius="16" Padding="5">
                        <DataGrid ItemsSource="{Binding SystemLogs}" AutoGenerateColumns="False"
                            IsReadOnly="True" GridLinesVisibility="Horizontal">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="{Binding LogColor}" />
                                    <Setter Property="Height" Value="55" />
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tarih / Saat"
                                    Binding="{Binding Date, StringFormat='dd.MM.yyyy HH:mm:ss'}"
                                    Width="160" Foreground="#64748B" />
                                <DataGridTextColumn Header="İşlem Tipi"
                                    Binding="{Binding DisplayActionType}" Width="140" FontWeight="Bold" />

                                <!-- TextWrapping Enabled Description -->
                                <DataGridTemplateColumn Header="Detay ve Açıklama" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Description}"
                                                TextWrapping="Wrap" VerticalAlignment="Center"
                                                Margin="5" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center">
                                                <Button Content="✏️"
                                                    Command="{Binding DataContext.OpenEditLogCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent" BorderThickness="0"
                                                    Cursor="Hand" Margin="0,0,10,0"
                                                    ToolTip="Düzenle" FontSize="18" />

                                                <Button Content="🗑️"
                                                    Command="{Binding DataContext.DeleteLogCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent" Foreground="#EF4444"
                                                    BorderThickness="0" Cursor="Hand" ToolTip="Sil"
                                                    FontSize="18" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    
                    <!-- Logs Pagination Footer -->
                    <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="8" Padding="15" Margin="0,10,0,0">
                        <Border.Effect>
                            <DropShadowEffect RenderingBias="Performance" Color="#E2E8F0" Opacity="0.5" BlurRadius="10" ShadowDepth="2" />
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <Button Content="◀ ÖNCEKİ" Command="{Binding PrevLogPageCommand}" Background="#F1F5F9" Foreground="#475569" FontWeight="Bold" Height="45" Padding="25,0" Style="{StaticResource RoundedBtn}" />
                            
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Sayfa: " FontSize="14" FontWeight="SemiBold" Foreground="#64748B" />
                                <TextBlock Text="{Binding CurrentLogPage}" FontSize="16" FontWeight="ExtraBold" Foreground="#2563EB" Margin="5,0" />
                                <TextBlock Text="/" FontSize="14" FontWeight="SemiBold" Foreground="#64748B" Margin="5,0" />
                                <TextBlock Text="{Binding TotalLogPages}" FontSize="14" FontWeight="Bold" Foreground="#64748B" Margin="5,0" />
                            </StackPanel>
                            
                            <Button Grid.Column="2" Content="SONRAKİ ▶" Command="{Binding NextLogPageCommand}" Background="#F1F5F9" Foreground="#475569" FontWeight="Bold" Height="45" Padding="25,0" Style="{StaticResource RoundedBtn}" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
