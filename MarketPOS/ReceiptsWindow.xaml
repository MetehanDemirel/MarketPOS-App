<Window x:Class="MarketPOS.ReceiptsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fiş Listesi / Geçmiş İşlemler" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    
    <Window.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9" />
            <Setter Property="RowHeight" Value="55" /> 
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="FontSize" Value="14" /> 
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="#94A3B8" />
                        <Setter Property="Padding" Value="15,0,0,15" />
                        <Setter Property="FontWeight" Value="Bold" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="BorderBrush" Value="#E2E8F0" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedBtn" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Border Background="#F1F5F9" CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect RenderingBias="Performance" Color="#64748B" Opacity="0.2" BlurRadius="25" ShadowDepth="10"/>
        </Border.Effect>
        <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Background="White" CornerRadius="12" Padding="10">
                <StackPanel Orientation="Horizontal">
                    <DatePicker SelectedDate="{Binding ReportStartDate}" Width="140"
                        Height="40" VerticalContentAlignment="Center" FontSize="14" />
                    <TextBlock Text="➙" VerticalAlignment="Center" Margin="10,0"
                        Foreground="#94A3B8" />
                    <DatePicker SelectedDate="{Binding ReportEndDate}" Width="140"
                        Height="40" VerticalContentAlignment="Center" FontSize="14" />
                    <Button Content="RAPORU GETİR"
                        Command="{Binding CalculateReportCommand}" Margin="15,0,0,0"
                        Width="140" Height="40" Background="#1E293B" Foreground="White"
                        FontWeight="Bold" Style="{StaticResource RoundedBtn}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="10"
                Width="250" Margin="0,0,20,0">
                <DockPanel>
                    <TextBlock Text="🔍" VerticalAlignment="Center" Margin="5,0,10,0"
                        FontSize="16" Foreground="#94A3B8" />
                    <TextBox
                        Text="{Binding ReportSearchFiNo, UpdateSourceTrigger=PropertyChanged}"
                        VerticalContentAlignment="Center" BorderThickness="0"
                        FontSize="16" Tag="Fiş No Ara..." />
                </DockPanel>
            </Border>

            <Button Grid.Column="3" Content="✕" Click="BtnClose_Click"
                Width="45" Height="45" Background="White" Foreground="#EF4444"
                FontSize="20" FontWeight="Bold" BorderThickness="0" Cursor="Hand" ToolTip="Kapat">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="22.5" />
                    </Style>
                </Button.Resources>
                <Button.Effect>
                    <DropShadowEffect RenderingBias="Performance" Color="#000000" Opacity="0.1" BlurRadius="5" ShadowDepth="1"/>
                </Button.Effect>
            </Button>
        </Grid>

        <Border Grid.Row="1" Background="White" CornerRadius="16" Padding="5">
            <DataGrid ItemsSource="{Binding ReportTransactions}"
                AutoGenerateColumns="False" IsReadOnly="True"
                GridLinesVisibility="Horizontal">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="{Binding TypeColor}" />
                        <Setter Property="Height" Value="55" />
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Fiş No" Binding="{Binding Id}"
                        Width="80" FontWeight="Bold" />
                    <DataGridTextColumn Header="Tarih"
                        Binding="{Binding Date, StringFormat='dd.MM.yyyy HH:mm'}"
                        Width="160" Foreground="#64748B" />
                    <DataGridTextColumn Header="İşlem Tipi" Binding="{Binding DisplayType}"
                        Width="120" FontWeight="SemiBold" />
                    <DataGridTextColumn Header="Açıklama"
                        Binding="{Binding Description}" Width="*" />
                    <DataGridTextColumn Header="Tutar"
                        Binding="{Binding TotalAmount, StringFormat={}{0:N2} ₺}"
                        Width="140" FontWeight="ExtraBold" Foreground="#1E293B" />

                    <DataGridTemplateColumn Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="🔍 Detay"
                                    Command="{Binding DataContext.ShowTransactionDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="#475569" FontWeight="Bold" Cursor="Hand"
                                    FontSize="14" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
                    
        <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="8" Padding="15" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                            
                <Button Content="◀ ÖNCEKİ" Command="{Binding PrevReportPageCommand}" Background="#F1F5F9" Foreground="#475569" FontWeight="Bold" Height="45" Padding="25,0" Style="{StaticResource RoundedBtn}" />
                            
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Sayfa: " FontSize="14" FontWeight="SemiBold" Foreground="#64748B" />
                    <TextBlock Text="{Binding CurrentReportPage}" FontSize="16" FontWeight="ExtraBold" Foreground="#2563EB" Margin="5,0" />
                    <TextBlock Text="/" FontSize="14" FontWeight="SemiBold" Foreground="#64748B" Margin="5,0" />
                    <TextBlock Text="{Binding TotalReportPages}" FontSize="14" FontWeight="Bold" Foreground="#64748B" Margin="5,0" />
                </StackPanel>
                            
                <Button Grid.Column="2" Content="SONRAKİ ▶" Command="{Binding NextReportPageCommand}" Background="#F1F5F9" Foreground="#475569" FontWeight="Bold" Height="45" Padding="25,0" Style="{StaticResource RoundedBtn}" />
            </Grid>
        </Border>
        </Grid>
    </Border>
</Window>
