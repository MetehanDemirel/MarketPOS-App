<Window x:Class="MarketPOS.RefundWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="İade Islemi" Height="750" Width="550"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Border Background="#F8FAFC" CornerRadius="20" Padding="25">
        <Border.Effect>
            <DropShadowEffect RenderingBias="Performance" Color="#64748B" Opacity="0.2" BlurRadius="25" ShadowDepth="10"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,25">
                 <TextBlock Text="🔄 İade Menüsü" FontSize="24" FontWeight="ExtraBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                 <Button Content="✕" IsCancel="True" HorizontalAlignment="Right" VerticalAlignment="Center" Width="40" Height="40" Background="#F1F5F9" Foreground="#64748B" 
                            FontSize="20" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="20"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>

            <!-- Selector -->
            <StackPanel Grid.Row="1" Margin="0,0,0,25">
                <TextBlock Text="İade Edilecek İşlemi Seçin (Son 50 Islem)" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,8"/>
                <ComboBox x:Name="CmbTransactions" SelectionChanged="CmbTransactions_SelectionChanged" Height="55" VerticalContentAlignment="Center" FontSize="16" Padding="10,0" 
                          BorderBrush="#CBD5E1" BorderThickness="2" Background="White">
                    <ComboBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="12"/>
                        </Style>
                    </ComboBox.Resources>
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Id, StringFormat='#{0}'}" FontWeight="Bold" Width="70" Foreground="#3B82F6"/>
                                <TextBlock Text="{Binding Date, StringFormat='dd.MM HH:mm'}" Width="120" Foreground="#64748B"/>
                                <TextBlock Text="{Binding DisplayType}" Width="90" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding TotalAmount, StringFormat={}{0:N2} ₺}" FontWeight="Bold" Foreground="#1E293B"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <!-- Receipt Content -->
            <Border Grid.Row="2" Background="White" CornerRadius="16" Padding="0" Margin="0,0,0,25">
                 <Border.Effect>
                    <DropShadowEffect RenderingBias="Performance" Color="#000000" Opacity="0.05" BlurRadius="10"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F1F5F9" CornerRadius="16,16,0,0" Padding="15">
                        <TextBlock Text="📄 SEÇİLEN FİŞ İÇERİĞİ" FontSize="14" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
                        <ItemsControl x:Name="ListItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#334155" FontSize="16"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding Quantity}" Foreground="#64748B" FontWeight="Bold"/>
                                                <TextBlock Text=" x " Foreground="#94A3B8"/>
                                                <TextBlock Text="{Binding PriceAtSale, StringFormat={}{0:N2} ₺}" Foreground="#64748B"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Total, StringFormat={}{0:N2} ₺}" FontWeight="Bold" Foreground="#1E293B" FontSize="16" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="0,2,0,0" Padding="20">
                        <DockPanel>
                            <TextBlock Text="TOPLAM IADE TUTARI" FontWeight="Bold" Foreground="#EF4444" VerticalAlignment="Center" FontSize="14"/>
                            <TextBlock x:Name="TxtRefundTotal" Text="0.00 ₺" FontSize="28" FontWeight="ExtraBold" Foreground="#EF4444" HorizontalAlignment="Right"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Buttons -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="1.5*"/>
                </Grid.ColumnDefinitions>
                
                <Button Grid.Column="0" Content="₺ IPTAL" IsCancel="True" Click="BtnCancel_Click" Height="60" Background="#F1F5F9" Foreground="#64748B" FontWeight="Bold" FontSize="16" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="12"/>
                        </Style>
                    </Button.Resources>
                </Button>
                
                <Button Grid.Column="2" Content="BU FISI IADE ET" Click="BtnConfirm_Click" Height="60" Background="#EF4444" Foreground="White" FontWeight="Bold" FontSize="18" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="12"/>
                        </Style>
                    </Button.Resources>
                    <Button.Effect>
                        <DropShadowEffect RenderingBias="Performance" Color="#EF4444" Opacity="0.3" BlurRadius="15" ShadowDepth="5"/>
                    </Button.Effect>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
