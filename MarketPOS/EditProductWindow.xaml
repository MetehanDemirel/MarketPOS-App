<Window x:Class="MarketPOS.EditProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ürün Düzenle" Height="680" Width="450"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        xmlns:conv="clr-namespace:MarketPOS.Converters">
    
    <Window.Resources>
        <conv:StringToDecimalConverter x:Key="DecConv" />
    </Window.Resources>
    
    <Border Background="#F8FAFC" CornerRadius="20" Padding="30">
        <Border.Effect>
            <DropShadowEffect RenderingBias="Performance" Color="#64748B" Opacity="0.2" BlurRadius="25" ShadowDepth="10"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Text="✏️ Ürün Düzenle" FontSize="26" FontWeight="ExtraBold" Foreground="#1E293B" HorizontalAlignment="Center" Margin="0,0,0,30"/>

            <!-- Form -->
            <StackPanel Grid.Row="1">
                <TextBlock Text="Barkod" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Barcode}" Height="50" VerticalContentAlignment="Center" FontSize="16" FontWeight="SemiBold" Padding="10" 
                         BorderBrush="#CBD5E1" BorderThickness="2" Margin="0,0,0,20">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <TextBlock Text="Ürün Adı" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Name}" Height="50" VerticalContentAlignment="Center" FontSize="16" FontWeight="SemiBold" Padding="10" 
                         BorderBrush="#CBD5E1" BorderThickness="2" Margin="0,0,0,20">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <TextBlock Text="Kategori" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,5"/>
                <ComboBox x:Name="CmbCategories" SelectedValue="{Binding Category}" Height="50" VerticalContentAlignment="Center" FontSize="16" FontWeight="SemiBold" 
                          Padding="10" BorderBrush="#CBD5E1" BorderThickness="2" Margin="0,0,0,20">
                     <ComboBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </ComboBox.Resources>
                </ComboBox>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Maliyet" FontWeight="Bold" Foreground="#EF4444" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding Cost, Converter={StaticResource DecConv}, UpdateSourceTrigger=LostFocus}" Height="50" VerticalContentAlignment="Center" FontSize="18" FontWeight="Bold" Padding="10" 
                                 BorderBrush="#FECACA" BorderThickness="2" Background="#FEF2F2">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="10"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Satış Fiyatı" FontWeight="Bold" Foreground="#10B981" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding Price, Converter={StaticResource DecConv}, UpdateSourceTrigger=LostFocus}" Height="50" VerticalContentAlignment="Center" FontSize="18" FontWeight="Bold" Padding="10" 
                                 BorderBrush="#A7F3D0" BorderThickness="2" Background="#ECFDF5">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="10"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Stok Durumu" FontWeight="Bold" Foreground="#3B82F6" Margin="0,0,0,5"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>

                    <Button Content="-" Click="BtnStockDec_Click" Background="#E2E8F0" Foreground="#1E293B" FontSize="24" FontWeight="Bold" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10,0,0,10"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <TextBox Text="{Binding Stock}" Height="50" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="20" FontWeight="ExtraBold" 
                             BorderBrush="#BFDBFE" BorderThickness="2,2,2,2" Background="#EFF6FF" Grid.Column="1" Margin="-2,0,-2,0" Panel.ZIndex="1"/>

                    <Button Grid.Column="2" Content="+" Click="BtnStockInc_Click" Background="#E2E8F0" Foreground="#1E293B" FontSize="24" FontWeight="Bold" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="0,10,10,0"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- Buttons -->
            <Grid Grid.Row="2" Margin="0,30,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                
                <Button Content="VAZGEÇ" Click="BtnCancel_Click" Height="55" Background="#F1F5F9" Foreground="#64748B" FontSize="16" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="12"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Grid.Column="2" Content="GÜNCELLE" Click="BtnSave_Click" Height="55" Background="#2563EB" Foreground="White" FontSize="16" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="12"/>
                        </Style>
                    </Button.Resources>
                    <Button.Effect>
                        <DropShadowEffect RenderingBias="Performance" Color="#2563EB" Opacity="0.4" BlurRadius="20" ShadowDepth="5"/>
                    </Button.Effect>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
