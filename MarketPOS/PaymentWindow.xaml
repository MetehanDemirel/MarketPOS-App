<Window x:Class="MarketPOS.PaymentWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Ödeme Al" Height="650" Width="950"
    WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
    WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Window.Resources>
        <Style x:Key="PayBtn" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#F8FAFC" CornerRadius="25" Padding="25">
        <Border.Effect>
            <DropShadowEffect RenderingBias="Performance" Color="#000000" Opacity="0.25" BlurRadius="30" ShadowDepth="10" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header Amount -->
            <Border Grid.Row="0" Background="White" CornerRadius="20" Padding="20" Margin="0,0,0,25">
                <Border.Effect>
                    <DropShadowEffect RenderingBias="Performance" Color="#000000" Opacity="0.05" BlurRadius="10" />
                </Border.Effect>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="TOPLAM TUTAR" FontSize="14" Foreground="#64748B"
                            HorizontalAlignment="Center" FontWeight="Bold" />
                        <TextBlock Text="{Binding TotalAmount, StringFormat={}{0:N2} ₺}"
                            FontSize="60" FontWeight="Black" Foreground="#1E293B"
                            HorizontalAlignment="Center" Margin="0,-5,0,0" />
                    </StackPanel>
                    <Button Content="✕" IsCancel="True" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Width="40" Height="40" Background="#F1F5F9"
                        Foreground="#64748B"
                        FontSize="20" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                        Style="{StaticResource PayBtn}" />
                </Grid>
            </Border>

            <!-- Main Content -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="400" />
                    <ColumnDefinition Width="25" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Numeric Pad -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="⚡ HIZLI NAKİT EKLE" Foreground="#64748B"
                        FontWeight="Bold"
                        HorizontalAlignment="Center" Margin="0,0,0,15" />

                    <UniformGrid Grid.Row="1" Columns="3" Rows="3">
                        <Button Content="50 ₺" Tag="50" Click="BtnQuickMoney_Click" Margin="4"
                            Background="#34D399" Foreground="White" FontWeight="Bold" FontSize="22"
                            Style="{StaticResource PayBtn}" />
                        <Button Content="100 ₺" Tag="100" Click="BtnQuickMoney_Click" Margin="4"
                            Background="#FBBF24" Foreground="White" FontWeight="Bold" FontSize="22"
                            Style="{StaticResource PayBtn}" />
                        <Button Content="200 ₺" Tag="200" Click="BtnQuickMoney_Click" Margin="4"
                            Background="#F87171" Foreground="White" FontWeight="Bold" FontSize="22"
                            Style="{StaticResource PayBtn}" />

                        <Button Content="5 ₺" Tag="5" Click="BtnQuickMoney_Click" Margin="4"
                            Background="#A78BFA" Foreground="White" FontWeight="Bold" FontSize="22"
                            Style="{StaticResource PayBtn}" />
                        <Button Content="10 ₺" Tag="10" Click="BtnQuickMoney_Click" Margin="4"
                            Background="#818CF8" Foreground="White" FontWeight="Bold" FontSize="22"
                            Style="{StaticResource PayBtn}" />
                        <Button Content="20 ₺" Tag="20" Click="BtnQuickMoney_Click" Margin="4"
                            Background="#60A5FA" Foreground="White" FontWeight="Bold" FontSize="22"
                            Style="{StaticResource PayBtn}" />

                        <Button Content="0.5 ₺" Tag="0.5" Click="BtnQuickMoney_Click" Margin="4"
                            Background="#C4B5FD" Foreground="#4C1D95" FontWeight="Bold"
                            FontSize="20"
                            Style="{StaticResource PayBtn}" />
                        <Button Content="1 ₺" Tag="1" Click="BtnQuickMoney_Click" Margin="4"
                            Background="#C4B5FD" Foreground="#4C1D95" FontWeight="Bold"
                            FontSize="20"
                            Style="{StaticResource PayBtn}" />
                        <Button Content="500 ₺" Tag="500" Click="BtnQuickMoney_Click" Margin="4"
                            Background="#F472B6" Foreground="White" FontWeight="Bold" FontSize="22"
                            Style="{StaticResource PayBtn}" />
                    </UniformGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,20,0,0">
                        <Button Content="NAKITI SIFIRLA" Click="BtnClearCash_Click" Height="50"
                            Width="195" Margin="0,0,10,0" Background="#E2E8F0" Foreground="#64748B"
                            FontWeight="Bold" FontSize="14" Style="{StaticResource PayBtn}" />
                        <Button Content="KARTI SIFIRLA" Click="BtnClearCard_Click" Height="50"
                            Width="195" Background="#E2E8F0" Foreground="#64748B" FontWeight="Bold"
                            FontSize="14" Style="{StaticResource PayBtn}" />
                    </StackPanel>
                </Grid>

                <!-- Payment Inputs -->
                <StackPanel Grid.Column="2">
                    <!-- Cash Input -->
                    <Border Background="White" CornerRadius="16" Padding="20" Margin="0,0,0,20"
                        BorderBrush="#E2E8F0" BorderThickness="2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Nakit Alinan" FontSize="14" FontWeight="Bold"
                                    Foreground="#10B981" />
                                <TextBox x:Name="TxtCash" TextChanged="TxtCash_TextChanged"
                                    GotFocus="TxtInput_GotFocus" FontSize="36" FontWeight="Bold"
                                    BorderThickness="0" VerticalContentAlignment="Center"
                                    Margin="0,5,0,0" Tag="0.00" Foreground="#1E293B" />
                            </StackPanel>
                            <Button Content="TAMI TAMINA" Click="BtnExactCash_Click" Grid.Column="1"
                                Background="#DCFCE7" Foreground="#10B981" FontWeight="Bold"
                                BorderThickness="0" Height="50" Padding="20,0" Cursor="Hand"
                                FontSize="14" Style="{StaticResource PayBtn}" />
                        </Grid>
                    </Border>

                    <!-- Card Input -->
                    <Border Background="White" CornerRadius="16" Padding="20" Margin="0,0,0,20"
                        BorderBrush="#E2E8F0" BorderThickness="2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Kartla Çekilen" FontSize="14" FontWeight="Bold"
                                    Foreground="#3B82F6" />
                                <TextBox x:Name="TxtCard" TextChanged="TxtCard_TextChanged"
                                    GotFocus="TxtInput_GotFocus" FontSize="36" FontWeight="Bold"
                                    BorderThickness="0" VerticalContentAlignment="Center"
                                    Margin="0,5,0,0" Tag="0.00" Foreground="#1E293B" />
                            </StackPanel>
                            <Button Content="KALANI DOLDUR" Click="BtnFillCard_Click"
                                Grid.Column="1" Background="#DBEAFE" Foreground="#3B82F6"
                                FontWeight="Bold" BorderThickness="0" Height="50" Padding="20,0"
                                Cursor="Hand" FontSize="14" Style="{StaticResource PayBtn}" />
                        </Grid>
                    </Border>

                    <!-- Status Display -->
                    <Border Background="#F8FAFC" CornerRadius="16" Padding="15">
                        <Grid>
                            <TextBlock x:Name="LblStatusTitle" Text="Kalan Tutar"
                                Foreground="#EF4444" FontSize="18" FontWeight="Bold"
                                VerticalAlignment="Center" HorizontalAlignment="Left" />

                            <TextBlock x:Name="LblRemaining" Text="0.00 ₺"
                                FontSize="40" FontWeight="Black" Foreground="#EF4444"
                                HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Confirm Button -->
            <Button Grid.Row="2" x:Name="BtnConfirm" Content="ÖDEMEYİ TAMAMLA"
                Click="BtnConfirm_Click" Height="75" Background="#1E293B" Foreground="White"
                FontWeight="Bold" FontSize="24" BorderThickness="0" Cursor="Hand" Margin="0,20,0,0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="16" />
                    </Style>
                </Button.Resources>
                <Button.Effect>
                    <DropShadowEffect RenderingBias="Performance" Color="#1E293B" Opacity="0.3" BlurRadius="15" ShadowDepth="5" />
                </Button.Effect>
            </Button>
        </Grid>
    </Border>
</Window>
