<Window x:Class="MarketPOS.DiscountWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="% İNDİRİM EKLE" Height="600" Width="480"
    WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
    WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Window.Resources>
        <Style x:Key="NumpadBtn" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="Margin" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.8" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="24" Padding="25">
        <Border.Effect>
            <DropShadowEffect RenderingBias="Performance" Color="#000000" Opacity="0.15" BlurRadius="25" ShadowDepth="10" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="% İNDİRİM EKLE" FontSize="22" FontWeight="ExtraBold"
                    Foreground="#0F172A" VerticalAlignment="Center" />
                <Button Content="✕" IsCancel="True" HorizontalAlignment="Right" Width="45"
                    Height="45" Background="#F1F5F9" Foreground="#64748B" FontSize="20" FontWeight="Bold"
                    BorderThickness="0" Style="{StaticResource NumpadBtn}" Margin="0" />
            </DockPanel>

            <!-- Display -->
            <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="16" Margin="0,0,0,20" Padding="20">
                <DockPanel>
                    <TextBlock Text="%" FontSize="48" FontWeight="Black" Foreground="#64748B" VerticalAlignment="Center" DockPanel.Dock="Right" Margin="10,0,0,0"/>
                    <TextBlock x:Name="TxtDisplay" Text="0" FontSize="56" FontWeight="Black"
                               Foreground="#3B82F6" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Numpad -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <!-- Row 0 -->
                <Button Grid.Row="0" Grid.Column="0" Content="7" Click="BtnNumpad_Click" Style="{StaticResource NumpadBtn}" />
                <Button Grid.Row="0" Grid.Column="1" Content="8" Click="BtnNumpad_Click" Style="{StaticResource NumpadBtn}" />
                <Button Grid.Row="0" Grid.Column="2" Content="9" Click="BtnNumpad_Click" Style="{StaticResource NumpadBtn}" />
                <Button Grid.Row="0" Grid.Column="3" Content="C" Click="BtnClear_Click" Style="{StaticResource NumpadBtn}" Background="#FEF2F2" Foreground="#EF4444" />

                <!-- Row 1 -->
                <Button Grid.Row="1" Grid.Column="0" Content="4" Click="BtnNumpad_Click" Style="{StaticResource NumpadBtn}" />
                <Button Grid.Row="1" Grid.Column="1" Content="5" Click="BtnNumpad_Click" Style="{StaticResource NumpadBtn}" />
                <Button Grid.Row="1" Grid.Column="2" Content="6" Click="BtnNumpad_Click" Style="{StaticResource NumpadBtn}" />
                <Button Grid.Row="1" Grid.Column="3" Content="⌫" Click="BtnBackspace_Click" Style="{StaticResource NumpadBtn}" Background="#FFF7ED" Foreground="#F97316" />

                <!-- Row 2 -->
                <Button Grid.Row="2" Grid.Column="0" Content="1" Click="BtnNumpad_Click" Style="{StaticResource NumpadBtn}" />
                <Button Grid.Row="2" Grid.Column="1" Content="2" Click="BtnNumpad_Click" Style="{StaticResource NumpadBtn}" />
                <Button Grid.Row="2" Grid.Column="2" Content="3" Click="BtnNumpad_Click" Style="{StaticResource NumpadBtn}" />
                <Button Grid.Row="2" Grid.Column="3" Grid.RowSpan="2" Content="EKLE" Click="BtnOk_Click" Style="{StaticResource NumpadBtn}" Background="#3B82F6" Foreground="White" FontSize="22" />

                <!-- Row 3 -->
                <Button Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Content="0" Click="BtnNumpad_Click" Style="{StaticResource NumpadBtn}" />
            </Grid>
        </Grid>
    </Border>
</Window>
