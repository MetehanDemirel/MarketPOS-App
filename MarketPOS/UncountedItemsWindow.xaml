<Window x:Class="MarketPOS.UncountedItemsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sayılmayan Satılan Ürünler" Height="700" Width="900"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    
    <Border Background="#F8FAFC" CornerRadius="20" Margin="10">
        <Border.Effect>
            <DropShadowEffect RenderingBias="Performance" Color="#64748B" Opacity="0.2" BlurRadius="25" ShadowDepth="10"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#1E293B" CornerRadius="20,20,0,0" Padding="25,20">
                <Grid>
                    <TextBlock Text="📉 Sayılmayan Satılan Ürünler" Foreground="White" FontSize="22" FontWeight="ExtraBold" VerticalAlignment="Center"/>
                    <Button Content="✕" Click="Close_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Width="40" Height="40" Background="#334155" Foreground="White" 
                            FontSize="18" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>

            <!-- Filters -->
            <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="Başlangıç Tarihi" FontSize="12" Foreground="#64748B" FontWeight="Bold" Margin="0,0,0,5"/>
                        <DatePicker x:Name="DpStart" Width="180" Height="40" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="Bitiş Tarihi" FontSize="12" Foreground="#64748B" FontWeight="Bold" Margin="0,0,0,5"/>
                        <DatePicker x:Name="DpEnd" Width="180" Height="40" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <Button Content="SORGULA / YENİLE" Click="Refresh_Click" Margin="0,17,0,0" Padding="25,0" Height="40" Background="#3B82F6" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="2" Margin="20">
                <DataGrid x:Name="DgItems" AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent" BorderThickness="0" 
                          CanUserAddRows="False" GridLinesVisibility="None" RowBackground="White" AlternatingRowBackground="#F8FAFC"
                          FontSize="15" RowHeight="50">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="#94A3B8" />
                            <Setter Property="Padding" Value="15,0,0,10" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="BorderBrush" Value="#E2E8F0" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ürün Adı" Binding="{Binding ProductName}" Width="*" FontWeight="SemiBold" Foreground="#1E293B"/>
                        <DataGridTextColumn Header="Satılan Adet" Binding="{Binding TotalQuantity}" Width="150" Foreground="#3B82F6" FontWeight="Bold"/>
                        <DataGridTextColumn Header="Toplam Tutar" Binding="{Binding TotalAmount, StringFormat={}{0:N2} ₺}" Width="150" Foreground="#10B981" FontWeight="Bold"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="3" Background="#F1F5F9" CornerRadius="0,0,20,20" Padding="20">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Genel Toplam:" FontSize="16" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="TxtGrandTotal" Text="0,00 ₺" FontSize="20" FontWeight="ExtraBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
