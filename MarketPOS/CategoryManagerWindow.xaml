<Window x:Class="MarketPOS.CategoryManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kategori Yönetimi" Height="650" Width="450"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>

    <Border Background="#F8FAFC" CornerRadius="20" Padding="25">
        <Border.Effect>
            <DropShadowEffect RenderingBias="Performance" Color="#64748B" Opacity="0.2" BlurRadius="25" ShadowDepth="10"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,25">
                <TextBlock Text="📦 Kategoriler" FontSize="24" FontWeight="ExtraBold" Foreground="#1E293B" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <Button Content="✖" IsCancel="True" HorizontalAlignment="Right" VerticalAlignment="Center" Width="40" Height="40" Background="#F1F5F9" Foreground="#64748B" 
                        FontSize="18" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="20"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>

            <!-- Add New -->
            <Grid Grid.Row="1" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                
                <TextBox x:Name="TxtCatName" Height="50" VerticalContentAlignment="Center" FontSize="16" FontWeight="SemiBold" Padding="15,0" 
                         BorderBrush="#7C3AED" BorderThickness="2" Tag="Yeni Kategori...">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="12"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <Button Grid.Column="2" Content="EKLE" Click="BtnAdd_Click" Height="50" Background="#7C3AED" Foreground="White" FontSize="16" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="12"/>
                        </Style>
                    </Button.Resources>
                    <Button.Effect>
                        <DropShadowEffect RenderingBias="Performance" Color="#7C3AED" Opacity="0.4" BlurRadius="15" ShadowDepth="4"/>
                    </Button.Effect>
                </Button>
            </Grid>

            <!-- Legend -->
            <Border Grid.Row="2" Background="#FFF7ED" CornerRadius="10" Padding="12" Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="☑ " FontSize="14" Foreground="#9A3412"/>
                    <TextBlock Text="= Satışlardan sayılmayan kategori (Ciro'ya dahil edilmez)" FontSize="12" Foreground="#9A3412" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- List -->
            <Border Grid.Row="3" Background="White" CornerRadius="16" Padding="5">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ListCategories" Padding="10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F1F5F9" Margin="0,0,0,8" Padding="12" CornerRadius="12">
                                    <DockPanel>
                                        <!-- Uncounted CheckBox -->
                                        <CheckBox IsChecked="{Binding IsUncounted, Mode=TwoWay}" 
                                                  VerticalAlignment="Center" Margin="0,0,10,0"
                                                  Checked="ChkUncounted_Changed" Unchecked="ChkUncounted_Changed"
                                                  ToolTip="Sayılmayan kategori olarak işaretle"/>
                                        
                                        <!-- Category Name -->
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="#334155"/>
                                            <TextBlock Text="(Sayılmıyor)" FontSize="11" Foreground="#F97316" FontWeight="Bold" 
                                                       Visibility="{Binding IsUncounted, Converter={StaticResource BoolToVisibility}}"/>
                                        </StackPanel>
                                        
                                        <!-- Delete Button -->
                                        <Button Content="SİL" Tag="{Binding Name}" Click="BtnDelete_Click" HorizontalAlignment="Right" DockPanel.Dock="Right"
                                                Background="#FFE4E6" Foreground="#E11D48" BorderThickness="0" Padding="15,8" FontSize="12" FontWeight="Bold" Cursor="Hand">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="8"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>
    </Border>
</Window>
