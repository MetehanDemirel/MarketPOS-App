<Window x:Class="MarketPOS.CustomerSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Müşteri Seç" Height="600" Width="600"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    
    <Border Background="#F8FAFC" CornerRadius="20" Padding="25">
        <Border.Effect>
            <DropShadowEffect RenderingBias="Performance" Color="#64748B" Opacity="0.2" BlurRadius="25" ShadowDepth="10"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,25">
                 <TextBlock Text="👥 Müşteri Seçimi" FontSize="26" FontWeight="ExtraBold" Foreground="#1E293B" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                 <Button Content="✕" IsCancel="True" Click="BtnCancel_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Width="45" Height="45" Background="#F1F5F9" Foreground="#64748B" 
                            FontSize="22" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="25"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>

            <!-- Search -->
            <Border Grid.Row="1" Background="White" CornerRadius="16" Padding="15" Margin="0,0,0,20">
                <Border.Effect>
                    <DropShadowEffect RenderingBias="Performance" Color="#000000" Opacity="0.03" BlurRadius="5"/>
                </Border.Effect>
                <DockPanel>
                    <TextBlock Text="??" VerticalAlignment="Center" Margin="5,0,15,0" Foreground="#94A3B8" FontSize="18"/>
                    <TextBox x:Name="TxtSearch" TextChanged="TxtSearch_TextChanged" BorderThickness="0" VerticalContentAlignment="Center" FontSize="18" Height="35" Tag="Isim veya Telefon ara..." FontWeight="SemiBold" Foreground="#334155"/>
                </DockPanel>
            </Border>

            <!-- List Header -->
            <Border Grid.Row="2" VerticalAlignment="Top" Background="#F1F5F9" CornerRadius="12,12,0,0" Padding="20,15" Margin="0,0,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Müşteri Adi" FontWeight="Bold" Foreground="#64748B" FontSize="14"/>
                    <TextBlock Grid.Column="1" Text="Telefon" FontWeight="Bold" Foreground="#64748B" FontSize="14"/>
                    <TextBlock Grid.Column="2" Text="Bakiye" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Right" FontSize="14"/>
                </Grid>
            </Border>

            <!-- List Content -->
            <Border Grid.Row="2" Margin="0,50,0,20" BorderBrush="#F1F5F9" BorderThickness="2,0,2,2" CornerRadius="0,0,12,12" Background="White">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ListCustomers">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="20,15" Background="White">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center" FontSize="16" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Phone}" Foreground="#94A3B8" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="2" Text="{Binding DebtBalance, StringFormat={}{0:N2} ₺}" FontWeight="Bold" Foreground="#EF4444" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="16"/>

                                        <Button Grid.Column="3" Content="SEÇ" Click="BtnSelect_Click" Tag="{Binding}" 
                                                Background="#3B82F6" Foreground="White" FontWeight="Bold" BorderThickness="0" Height="40" HorizontalAlignment="Right" Width="80" Cursor="Hand" FontSize="14">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="8"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Footer (Cancel is now top right, but maybe keep generic close here if needed₺ Removed for cleaner look, only X at top) -->
        </Grid>
    </Border>
</Window>
