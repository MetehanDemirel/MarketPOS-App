<Window x:Class="MarketPOS.AddCustomerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Müşteri Ekle" Height="500" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    
    <Border Background="#F8FAFC" CornerRadius="20" Padding="25">
        <Border.Effect>
            <DropShadowEffect RenderingBias="Performance" Color="#64748B" Opacity="0.2" BlurRadius="25" ShadowDepth="10"/>
        </Border.Effect>

        <StackPanel>
            <!-- Header -->
             <Grid Margin="0,0,0,25">
                 <TextBlock Text="📝 Yeni Müşteri" FontSize="24" FontWeight="ExtraBold" Foreground="#1E293B" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                 <Button Content="✕" IsCancel="True" HorizontalAlignment="Right" VerticalAlignment="Center" Width="40" Height="40" Background="#F1F5F9" Foreground="#64748B" 
                            FontSize="20" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="20"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>

            <TextBlock Text="Ad Soyad / Firma Adi" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtName" Height="50" VerticalContentAlignment="Center" FontSize="16" FontWeight="SemiBold" Padding="15,0" 
                     BorderBrush="#CBD5E1" BorderThickness="2" Margin="0,0,0,20">
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="10"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>

            <TextBlock Text="Telefon Numarasi" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtPhone" Height="50" VerticalContentAlignment="Center" FontSize="16" FontWeight="SemiBold" Padding="15,0" 
                     BorderBrush="#CBD5E1" BorderThickness="2" Margin="0,0,0,20">
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="10"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>

            <TextBlock Text="Baslangi₺ Borcu (Varsa)" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,5"/>
             <TextBox x:Name="TxtBalance" Text="0" Height="50" VerticalContentAlignment="Center" FontSize="18" FontWeight="Bold" Padding="15,0" 
                     BorderBrush="#FECACA" BorderThickness="2" Background="#FEF2F2" Margin="0,0,0,30" Foreground="#EF4444">
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="10"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>

            <Button Content="KAYDET" Click="BtnSave_Click" Height="60" Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="18" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="12"/>
                    </Style>
                </Button.Resources>
                <Button.Effect>
                    <DropShadowEffect RenderingBias="Performance" Color="#2563EB" Opacity="0.3" BlurRadius="15" ShadowDepth="5"/>
                </Button.Effect>
            </Button>
        </StackPanel>
    </Border>
</Window>
